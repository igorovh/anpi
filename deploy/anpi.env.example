# Copy to /etc/anpi/anpi.env (chmod 600) and adjust.
ANPI_BASE_URL=https://status.example.com
ANPI_TRUST_PROXY=true
# ANPI_LOG=info

# Keycloak / any OpenID Connect provider. When set, only SSO sign-in is allowed.
# ANPI_OIDC_ISSUER=https://auth.example.com/realms/main
# ANPI_OIDC_CLIENT_ID=anpi
# ANPI_OIDC_CLIENT_SECRET=change-me
# ANPI_OIDC_REQUIRED_ROLE=monitoring
# ANPI_OIDC_SCOPES=openid profile email
