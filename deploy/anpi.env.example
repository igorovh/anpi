# Copy to /etc/anpi/anpi.env (chmod 600) and adjust.
ANPI_BASE_URL=https://status.example.com
ANPI_TRUST_PROXY=true

# Serve HTTPS directly, without a reverse proxy (e.g. a Cloudflare origin certificate).
# ANPI_BIND=[::]:443
# ANPI_TLS_CERT=/etc/anpi/origin.pem
# ANPI_TLS_KEY=/etc/anpi/origin.key
# ANPI_CLIENT_IP_HEADER=CF-Connecting-IP
# Peers allowed to set the client address; private networks by default.
# ANPI_TRUSTED_PROXIES=2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32
# ANPI_LOG=info

# Keycloak / any OpenID Connect provider. When set, only SSO sign-in is allowed.
# ANPI_OIDC_ISSUER=https://auth.example.com/realms/main
# ANPI_OIDC_CLIENT_ID=anpi
# ANPI_OIDC_CLIENT_SECRET=change-me
# ANPI_OIDC_REQUIRED_ROLE=monitoring
# ANPI_OIDC_SCOPES=openid profile email
