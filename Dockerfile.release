# Packages the static binaries built by the release workflow; use Dockerfile to build from source.
# Runs on the build machine, so multi-arch builds need no emulation; mirror.gcr.io avoids Docker Hub limits.
FROM --platform=$BUILDPLATFORM mirror.gcr.io/library/busybox:1.37-musl AS data
RUN mkdir -p /data && chown 65532:65532 /data

FROM gcr.io/distroless/static-debian12:nonroot
ARG TARGETARCH
COPY docker-bin/${TARGETARCH}/anpi /anpi
COPY --from=data --chown=65532:65532 /data /data
ENV ANPI_DATA_DIR=/data \
    ANPI_BIND=0.0.0.0:3000
VOLUME /data
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s CMD ["/anpi", "healthcheck"]
ENTRYPOINT ["/anpi"]
